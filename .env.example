# ============================================================================
# Phase 1: 基础 LLM 对话配置
# ============================================================================
# 复制此文件为 .env 并填入你的 API key
#   cp .env.example .env

# LLM API Key（必填）
LLM_API_KEY=sk-your-api-key-here

# API Base URL（根据你的 LLM 提供商选择）
# OpenAI 官方:       https://api.openai.com/v1
# DeepSeek:          https://api.deepseek.com/v1
# 火山引擎豆包:       https://ark.cn-beijing.volces.com/api/v3
# Moonshot(Kimi):    https://api.moonshot.cn/v1
# 阿里百炼:          https://dashscope.aliyuncs.com/compatible-mode/v1
# Ollama 本地:       http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# 模型名称
# OpenAI:     gpt-4o / gpt-4o-mini
# DeepSeek:   deepseek-chat / deepseek-reasoner
# 豆包:       doubao-seed-2-0-code-251228
# Kimi:       kimi-k2.5
LLM_MODEL=gpt-4o-mini

# 温度参数（0-2，越高越有创造性）
LLM_TEMPERATURE=0.7

# ============================================================================
# LangSmith 配置（可选，用于调试和追踪 Agent 执行过程）
# ============================================================================
# 注册: https://smith.langchain.com
LANGCHAIN_API_KEY=lsv2-your-langsmith-api-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=mini-agent
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
