# ============================================================================
# Phase 2: LangGraph Agent 配置
# ============================================================================
# 复制此文件为 .env 并填入你的 API key
#   cp .env.example .env

# LLM API Key（必填）
LLM_API_KEY=sk-your-api-key-here

# API Base URL（根据你的 LLM 提供商选择）
# OpenAI 官方:       https://api.openai.com/v1
# DeepSeek:          https://api.deepseek.com/v1
# 火山引擎豆包:       https://ark.cn-beijing.volces.com/api/v3
# Moonshot(Kimi):    https://api.moonshot.cn/v1
# 阿里百炼:          https://dashscope.aliyuncs.com/compatible-mode/v1
# Ollama 本地:       http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# 模型名称
# OpenAI:     gpt-4o / gpt-4o-mini
# DeepSeek:   deepseek-chat (非思考) / deepseek-reasoner (思考模式)
# 豆包:       doubao-seed-2-0-code-251228
# Kimi:       kimi-k2.5
LLM_MODEL=gpt-4o-mini

# 温度参数（0-2，越高越有创造性）
LLM_TEMPERATURE=0.7

# DeepSeek thinking 模式 (仅 DeepSeek 模型需要)
# 启用思考: LLM_EXTRA_BODY='{"thinking":{"type":"enabled"}}'
# 禁用思考: LLM_EXTRA_BODY='{"thinking":{"type":"disabled"}}'
# 不设置则使用 API 默认行为
LLM_EXTRA_BODY=
